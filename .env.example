# Copy this file to .env for local runs. Never commit a real .env file.
# This project only ever runs against local synthetic data, but the pattern
# below mirrors how configuration should be handled for real cloud projects:
# secrets are never hardcoded in source code.

DATA_LAKE_ROOT=./data
ENVIRONMENT=local
LOG_LEVEL=INFO

# Placeholders only. Do not put real credentials in version control.
# S3_BUCKET_NAME=
# REDSHIFT_HOST=
